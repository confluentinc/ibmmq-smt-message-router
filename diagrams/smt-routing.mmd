%% SMT Routing Logic - Simplified Diagram

flowchart LR
    subgraph mq["MQ Message"]
        props["MQ Properties:<br/>messageType=PAYMENT<br/>priority=HIGH<br/>businessUnit=RETAIL"]
    end

    subgraph connector["IBM MQ Source Connector"]
        convert["Convert MQ Properties<br/>→ Kafka Headers"]
    end

    subgraph smt["RegexRouter SMT"]
        read["Read Header:<br/>${header:messageType}"]
        determine["Determine Topic:<br/>PAYMENT"]
    end

    subgraph kafka["Kafka"]
        topic["Topic: PAYMENT"]
    end

    props --> convert
    convert -->|"Headers:<br/>messageType: PAYMENT<br/>priority: HIGH"| read
    read --> determine
    determine --> topic

    style mq fill:#134a8e,stroke:#0c2d57,color:#fff
    style connector fill:#7b68ee,stroke:#483d8b,color:#fff
    style smt fill:#ff6b6b,stroke:#c92a2a,color:#fff
    style kafka fill:#51cf66,stroke:#2b8a3e,color:#000
