%% SMT Routing Logic - Simplified Diagram

flowchart LR
    subgraph jms["JMS Message"]
        props["JMS Properties:<br/>messageType=PAYMENT<br/>priority=HIGH<br/>routingKey=RETAIL-PAYMENT"]
    end

    subgraph connector["JMS Source Connector"]
        convert["Convert JMS Properties<br/>→ Kafka Headers"]
    end

    subgraph smt["ExtractTopic$Header SMT"]
        read["Extract Header Value:<br/>field: messageType"]
        determine["Use as Topic Name:<br/>PAYMENT"]
    end

    subgraph kafka["Kafka"]
        topic["Topic: PAYMENT"]
    end

    props --> convert
    convert -->|"Headers:<br/>messageType: PAYMENT<br/>priority: HIGH"| read
    read --> determine
    determine --> topic

    style jms fill:#134a8e,stroke:#0c2d57,color:#fff
    style connector fill:#7b68ee,stroke:#483d8b,color:#fff
    style smt fill:#ff6b6b,stroke:#c92a2a,color:#fff
    style kafka fill:#51cf66,stroke:#2b8a3e,color:#000
