%% Simplified Architecture Diagram (for presentations/high-level overview)

flowchart LR
    subgraph source["Source: IBM MQ"]
        mq["Multiple Queues<br/>⬇<br/>GATEWAY.QUEUE"]
    end

    subgraph integration["Confluent Cloud"]
        connector["MQ Source Connector<br/>+<br/>SMT Routing"]
    end

    subgraph targets["Target: Kafka Topics"]
        direction TB
        t1["PAYMENT_DOMESTIC"]
        t2["PAYMENT_INTERNATIONAL"]
        t3["ACCOUNT_TRANSACTION"]
        t4["FRAUD_ALERT"]
    end

    mq ==>|"Messages with<br/>messageType property"| connector
    connector ==>|"Route by<br/>messageType header"| t1 & t2 & t3 & t4

    style mq fill:#134a8e,stroke:#0c2d57,color:#fff,stroke-width:3px
    style connector fill:#7b68ee,stroke:#483d8b,color:#fff,stroke-width:3px
    style t1 fill:#51cf66,stroke:#2b8a3e,color:#000,stroke-width:2px
    style t2 fill:#51cf66,stroke:#2b8a3e,color:#000,stroke-width:2px
    style t3 fill:#51cf66,stroke:#2b8a3e,color:#000,stroke-width:2px
    style t4 fill:#51cf66,stroke:#2b8a3e,color:#000,stroke-width:2px
