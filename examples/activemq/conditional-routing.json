{
  "name": "activemq-source-conditional-routing",
  "config": {
    "connector.class": "io.confluent.connect.activemq.ActiveMQSourceConnector",
    "tasks.max": "1",

    "kafka.topic": "jms-unrouted-dlq",

    "activemq.url": "tcp://${ACTIVEMQ_HOST}:61616",
    "activemq.username": "${ACTIVEMQ_USERNAME}",
    "activemq.password": "${ACTIVEMQ_PASSWORD}",

    "jms.destination.name": "KAFKA.AGGREGATION.QUEUE",
    "jms.destination.type": "queue",

    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",

    "_comment_transforms": "===== CONDITIONAL ROUTING WITH PREDICATES =====",

    "transforms": "routeHighPriority,routeNormal",
    "predicates": "isHighPriority",

    "_comment_predicate": "Define condition: message has 'priority' header with value 'HIGH'",
    "predicates.isHighPriority.type": "org.apache.kafka.connect.transforms.predicates.HasHeaderKey",
    "predicates.isHighPriority.name": "priority",

    "_comment_transform1": "Transform 1: Route high-priority messages to priority topics",
    "transforms.routeHighPriority.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.routeHighPriority.regex": ".*",
    "transforms.routeHighPriority.replacement": "${header:messageType}-priority",
    "transforms.routeHighPriority.predicate": "isHighPriority",

    "_comment_transform2": "Transform 2: Route normal messages to standard topics",
    "transforms.routeNormal.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.routeNormal.regex": ".*",
    "transforms.routeNormal.replacement": "${header:messageType}",
    "transforms.routeNormal.predicate": "isHighPriority",
    "transforms.routeNormal.negate": "true",

    "_comment_examples": "priority=HIGH + messageType=PAYMENT -> PAYMENT-priority topic",
    "_comment_examples2": "priority=NORMAL + messageType=PAYMENT -> PAYMENT topic",
    "_comment_usecase": "Useful for separating high-priority/urgent messages into different topics for specialized processing",
    "_comment_note": "SMT configuration is identical across JMS providers"
  }
}
